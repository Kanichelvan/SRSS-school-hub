{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "node server.mjs",
    "build": "vite build && node scripts/check-bundle-budget.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase --project demo-srss-tests emulators:exec --only firestore,storage \"node --test --test-concurrency=1 tests/rules/*.test.mjs\"",
    "emulators": "firebase emulators:start",
    "seed": "node scripts/seed-emulator.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules,storage"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "firebase": "^12.19.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.18.4",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.33.0"
  }
}
