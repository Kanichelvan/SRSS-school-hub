# Port for `npm run serve` (local preview of the production build).
PORT=8787

# ---- Secure hub (Firebase) ----
# Copy to .env.local. Leave VITE_USE_EMULATORS=true for local development (no Firebase account needed).
VITE_USE_EMULATORS=true

# Production project: SRSSDigitalHub (ID srssdigitalhub, number 181411841169).
# Copy the API key, storage bucket and app ID from Firebase console → Project settings → Your apps (Web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=srssdigitalhub.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=srssdigitalhub
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_REGION=asia-southeast1

# Google Workspace for Education domain for staff and student sign-in, e.g. srss.edu.my
VITE_WORKSPACE_DOMAIN=
