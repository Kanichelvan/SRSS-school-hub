{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/content/**",
              "components/feedback/**",
              "components/forms/**",
              "components/icons/**",
              "components/navigation/**",
              "ui_kits/srss_website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Calibri|Playfair Display))/i]",
        "message": "Font not provided by the design system. Available: Calibri, Playfair Display."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|tone|size|icon|underline|style|key|ref|className|style|children)$/]",
        "message": "<ArrowLink> doesn't accept that prop. Declared props: children, href, tone, size, icon, underline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:navy|onNavy|gold)$/]",
        "message": "<ArrowLink> tone must be one of 'navy' | 'onNavy' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<ArrowLink> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AudienceLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|href|tone|divider|style|key|ref|className|style|children)$/]",
        "message": "<AudienceLink> doesn't accept that prop. Declared props: title, body, href, tone, divider, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AudienceLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|navy)$/]",
        "message": "<AudienceLink> tone must be one of 'light' | 'navy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, style."
      },
